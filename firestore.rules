rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BootUP ratings: anyone can read and add a rating, nobody can edit or delete from the site.
    match /ratings/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['stars', 'name', 'comment', 'createdAt'])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
